{
  "name": "work-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "crawl": "tsx crawlers/run.ts",
    "crawl:diff": "tsx crawlers/diff.ts",
    "crawl:verify": "tsx crawlers/verify.ts",
    "crawl:experience": "tsx crawlers/run-experience.ts",
    "analyze": "tsx crawlers/diff.ts",
    "notify:discord": "tsx crawlers/notify-discord.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test crawlers/opportunity.test.ts",
    "serve": "cp crawlers/results.json web/results.json 2>/dev/null; cp crawlers/new-postings.json web/new-postings.json 2>/dev/null; npx serve web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
