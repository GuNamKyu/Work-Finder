{
  "name": "work-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "crawl": "tsx crawlers/run.ts",
    "crawl:diff": "tsx crawlers/diff.ts",
    "crawl:verify": "tsx crawlers/verify.ts",
    "crawl:experience": "tsx crawlers/run-experience.ts",
    "analyze": "tsx crawlers/diff.ts",
    "notify:discord": "tsx crawlers/notify-discord.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test crawlers/opportunity.test.ts crawlers/schedule.test.ts crawlers/resilience.test.ts web/model.test.js web/exclusions.test.js crawlers/exclusions.test.ts crawlers/sites/namuk.test.ts scripts/import-exclusions.test.mjs scripts/ui-publication.test.mjs",
    "exclusions:import": "node scripts/import-exclusions.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "serve": "npm run prepare:web && node scripts/serve.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:resilience:ui": "node scripts/test-resilience-ui.mjs",
    "test:resilience:analysis": "node scripts/test-resilience-analysis.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
